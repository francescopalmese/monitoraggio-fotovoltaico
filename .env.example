# Copia questo file come ".env" e compila i valori. Il file .env è escluso da git.

# Strada A: lettura locale via chiavetta Wi-Fi (porta 8899)
LOGGER_IP=              # indirizzo IP della chiavetta sulla rete di casa (dalla pagina del router)
LOGGER_SERIAL=          # seriale della chiavetta, 10 cifre (etichetta "SN" sulla chiavetta)
MODBUS_SLAVE_ID=1       # indirizzo Modbus dell'inverter (di norma 01, vedi display)

# Strada B: "API Terze Parti Azzurro" (quando arriva il token da ZCS)
ZCS_API_EMAIL=          # email dell'account Azzurro Systems (header x-api-key)
ZCS_API_TOKEN=          # token ricevuto da ZCS (header x-api-secret)
INVERTER_SERIAL=        # seriale dell'inverter (parametro thingKey)

# Tappa 2, dashboard: impianto e posizione per la produzione attesa PVGIS (API pubblica, senza chiave)
IMPIANTO_KWP=           # potenza dei pannelli in kWp (es. 9.8)
PVGIS_LAT=              # latitudine in gradi decimali, anche approssimata (es. 45.07)
PVGIS_LON=              # longitudine in gradi decimali (es. 7.69)
PVGIS_INCLINAZIONE=     # inclinazione dei pannelli dall'orizzontale, in gradi; vuoto = la sceglie PVGIS
PVGIS_ORIENTAMENTO=0    # orientamento: 0 = sud, 90 = ovest, -90 = est
PVGIS_PERDITE=14        # perdite di sistema in % (PVGIS propone 14)
DASHBOARD_PORTA=8780    # porta del server locale della dashboard (http://127.0.0.1:8780)
